+  for (const auto& setting : getSettingsList(&sdFontSystem.registry())) {
+    if (!setting.key || !doc[setting.key].is<JsonVariant>()) continue; const JsonVariant value = doc[setting.key];
+    if (setting.type == SettingType::TOGGLE && setting.valuePtr) SETTINGS.*(setting.valuePtr) = value.as<int>() ? 1 : 0;
+    else if (setting.type == SettingType::VALUE && setting.valuePtr) SETTINGS.*(setting.valuePtr) = value.as<uint8_t>();
+    else if (setting.type == SettingType::ENUM) { if (setting.valuePtr) SETTINGS.*(setting.valuePtr) = settingEnumRawValueForDisplayIndex(setting,value.as<uint8_t>()); else if(setting.valueSetter) setting.valueSetter(value.as<uint8_t>()); }
+    else if (setting.type == SettingType::STRING) { const std::string text = value.as<const char*>(); if (isPortalSecret(setting) && text.empty()) continue; if (setting.stringSetter) setting.stringSetter(text); else { char* out = reinterpret_cast<char*>(&SETTINGS)+setting.stringOffset; std::strncpy(out,text.c_str(),setting.stringMaxLen-1); out[setting.stringMaxLen-1]='\0'; } }
+    else continue;
+    applied.add(setting.key); if (std::string(setting.key) == "koboUiScalePercent") reboot = true;
+  }
+  if (!SETTINGS.saveToFile()) { sendResponse(client,500,"application/json","{\"error\":\"Could not save settings\"}"); return; }
