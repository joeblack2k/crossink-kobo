+// The Kobo must not carry a second, hand-written portal.  The embedded page is
+// produced from web/pages/portal.* by scripts/build_web.py.
+void sendKoboPortal(int client) {
+  sendResponse(client, 200, "text/html; charset=utf-8",
+               std::string(KoboPortalHtml, KoboPortalHtmlCompressedSize),
+               "Content-Encoding: gzip\r\nCache-Control: no-cache\r\n");
+}
+
+const char* portalSection(const char* key) {
+  if (key == nullptr) return "system";
+  const std::string k(key);
+  if (k == "fontFamily" || k == "fontSize" || k == "sdFontSizeRange" || k == "lineHeightPercent" ||
+      k == "screenMargin" || k == "paragraphAlignment" || k == "embeddedStyle" || k == "hyphenationEnabled" ||
+      k == "textAntiAliasing" || k == "readerDarkMode" || k == "imageRendering" ||
+      k == "extraParagraphSpacing" || k == "forceParagraphIndents" || k == "bionicReadingEnabled" ||
+      k == "guideReadingEnabled" || k == "orientation") return "reading";
+  if (k == "frontlightBrightness" || k == "koboUiScalePercent" || k == "uiTheme" ||
+      k == "refreshFrequency" || k.find("statusBar") == 0 || k == "hideClock" ||
+      k == "hideBatteryPercentage" || k == "xtcStatusBarMode") return "display";
+  if (k == "recentBooksView" || k == "showHiddenFiles" || k == "hideFileExtension" ||
+      k == "fileBrowserDisplay" || k == "removeReadBooksFromRecents" || k == "moveFinishedToReadFolder" ||
+      k == "trackReadingStats") return "library";
+  if (k.find("PwrBtn") != std::string::npos || k.find("Button") != std::string::npos ||
+      k.find("Press") != std::string::npos || k == "pwrBtnFootnoteBack" || k == "sideButtonLayout" ||
+      k == "sideButtonOrientationAware" || k == "sideButtonLongPress") return "controls";
+  if (k.find("sleep") != std::string::npos || k.find("Sleep") != std::string::npos) return "power";
+  return "system";
+}
+
+bool portalSecret(const SettingInfo& setting) {
+  return setting.key != nullptr && std::string(setting.key) == "koPassword";
+}
+
+uint8_t enumDisplayValue(const SettingInfo& setting) {
+  const uint8_t raw = setting.valuePtr ? SETTINGS.*(setting.valuePtr) : setting.valueGetter();
+  return settingEnumDisplayIndexForRawValue(setting, raw);
+}
+
+void addSettingJson(JsonArray array, const SettingInfo& setting) {
+  if (setting.key == nullptr) return;
+  JsonObject item = array.add<JsonObject>();
+  item["key"] = setting.key;
+  item["name"] = I18N.get(setting.nameId);
+  item["category"] = I18N.get(setting.category);
+  item["section"] = portalSection(setting.key);
+  item["effect"] = std::string(setting.key) == "koboUiScalePercent" ? "reboot" : "immediate";
+  item["secret"] = portalSecret(setting);
+  switch (setting.type) {
+    case SettingType::TOGGLE:
+      item["type"] = "toggle"; item["value"] = setting.valuePtr ? (SETTINGS.*(setting.valuePtr) ? 1 : 0) : 0; break;
+    case SettingType::ENUM: {
+      item["type"] = "enum"; item["value"] = enumDisplayValue(setting);
+      JsonArray options = item["options"].to<JsonArray>();
+      for (uint8_t i = 0; i < settingEnumOptionCount(setting); ++i) options.add(settingEnumOptionLabel(setting, i));
+      break;
+    }
+    case SettingType::VALUE:
+      item["type"] = "value"; item["value"] = SETTINGS.*(setting.valuePtr); item["min"] = setting.valueRange.min;
+      item["max"] = setting.valueRange.max; item["step"] = setting.valueRange.step; break;
+    case SettingType::STRING:
+      item["type"] = "string";
+      if (portalSecret(setting)) item["hasValue"] = setting.stringGetter && !setting.stringGetter().empty();
+      else if (setting.stringGetter) item["value"] = setting.stringGetter();
+      else item["value"] = reinterpret_cast<const char*>(&SETTINGS) + setting.stringOffset;
+      break;
+    default: array.remove(array.size() - 1); break;
+  }
+}
+
+void sendPortalSettings(int client) {
+  JsonDocument doc;
+  JsonArray values = doc.to<JsonArray>();
+  for (const auto& setting : getSettingsList(&sdFontSystem.registry())) addSettingJson(values, setting);
+  std::string body; serializeJson(doc, body); sendResponse(client, 200, "application/json", body);
+}
+
+bool validatePortalSettings(JsonDocument& doc, std::string& error) {
+  for (const auto& setting : getSettingsList(&sdFontSystem.registry())) {
+    if (setting.key == nullptr || !doc[setting.key].is<JsonVariant>()) continue;
+    const JsonVariant value = doc[setting.key];
+    if (setting.type == SettingType::ENUM && (!value.is<int>() || value.as<int>() < 0 ||
+        value.as<int>() >= static_cast<int>(settingEnumOptionCount(setting)))) { error = std::string("Invalid value for ") + setting.key; return false; }
+    if (setting.type == SettingType::VALUE && (!value.is<int>() || value.as<int>() < setting.valueRange.min ||
+        value.as<int>() > setting.valueRange.max)) { error = std::string("Invalid value for ") + setting.key; return false; }
+    if (setting.type == SettingType::STRING && !value.is<const char*>()) { error = std::string("Invalid text for ") + setting.key; return false; }
+    if (setting.type == SettingType::STRING && setting.stringMaxLen > 0 &&
+        std::string(value.as<const char*>()).size() >= setting.stringMaxLen) { error = std::string("Text is too long for ") + setting.key; return false; }
+  }
+  return true;
+}
+
+void applyPortalSettings(int client, const Request& request) {
+  JsonDocument doc;
+  if (deserializeJson(doc, request.body)) { sendResponse(client, 400, "application/json", "{\"error\":\"Invalid JSON\"}"); return; }
+  std::string error;
+  if (!validatePortalSettings(doc, error)) { sendResponse(client, 400, "application/json", std::string("{\"error\":\"") + jsonEscape(error) + "\"}"); return; }
+  JsonDocument result; JsonArray applied = result["applied"].to<JsonArray>(); bool reboot = false;
+  for (const auto& setting : getSettingsList(&sdFontSystem.registry())) {
+    if (setting.key == nullptr || !doc[setting.key].is<JsonVariant>()) continue;
+    const JsonVariant value = doc[setting.key];
+    switch (setting.type) {
+      case SettingType::TOGGLE: if (setting.valuePtr) SETTINGS.*(setting.valuePtr) = value.as<int>() ? 1 : 0; break;
+      case SettingType::ENUM: if (setting.valuePtr) SETTINGS.*(setting.valuePtr) = settingEnumRawValueForDisplayIndex(setting, value.as<uint8_t>()); else if (setting.valueSetter) setting.valueSetter(value.as<uint8_t>()); break;
+      case SettingType::VALUE: if (setting.valuePtr) SETTINGS.*(setting.valuePtr) = value.as<uint8_t>(); break;
+      case SettingType::STRING: {
+        const std::string text = value.as<const char*>();
+        if (portalSecret(setting) && text.empty()) continue;
+        if (setting.stringSetter) setting.stringSetter(text);
+        else { char* target = reinterpret_cast<char*>(&SETTINGS) + setting.stringOffset; std::strncpy(target, text.c_str(), setting.stringMaxLen - 1); target[setting.stringMaxLen - 1] = '\0'; }
+        break;
+      }
+      default: continue;
+    }
+    if (std::string(setting.key) == "koboUiScalePercent") reboot = true;
+    applied.add(setting.key);
+  }
+  if (!SETTINGS.saveToFile()) { sendResponse(client, 500, "application/json", "{\"error\":\"Could not save settings\"}"); return; }
+  result["rebootRequired"] = reboot; result["reopenReaderRequired"] = false;
+  std::string body; serializeJson(result, body); sendResponse(client, 200, "application/json", body);
+}
+
+void sendPortalServices(int client, const std::string& localAddress) {
+  JsonDocument doc;
+  const std::string base = localAddress.empty() ? std::string() : "http://" + localAddress;
+  doc["webTransferEnabled"] = SETTINGS.koboWebTransferEnabled != 0;
+  doc["webUrl"] = base; doc["webdavUrl"] = base.empty() ? "" : base + "/";
+  doc["calibre"] = WiFi.status() == WL_CONNECTED ? "Available on this Wi-Fi network" : "Connect Wi-Fi first";
+  JsonObject ko = doc["koreader"].to<JsonObject>(); ko["configured"] = KOREADER_STORE.hasCredentials();
+  ko["serverUrl"] = KOREADER_STORE.getServerUrl(); ko["username"] = KOREADER_STORE.getUsername();
+  ko["hasPassword"] = !KOREADER_STORE.getPassword().empty(); ko["matchMethod"] = static_cast<uint8_t>(KOREADER_STORE.getMatchMethod());
+  std::string body; serializeJson(doc, body); sendResponse(client, 200, "application/json", body);
+}
+
+void sendPortalWifi(int client) {
+  JsonDocument doc; JsonArray values = doc.to<JsonArray>(); const auto& networks = WIFI_STORE.getCredentials();
+  for (size_t index = 0; index < networks.size(); ++index) { JsonObject item = values.add<JsonObject>(); item["id"] = std::to_string(index); item["ssid"] = networks[index].ssid; item["hasPassword"] = !networks[index].password.empty(); }
+  std::string body; serializeJson(doc, body); sendResponse(client, 200, "application/json", body);
+}
+
+void sendPortalOpds(int client) {
+  JsonDocument doc; JsonArray values = doc.to<JsonArray>(); const auto& servers = OPDS_STORE.getServers();
+  for (size_t index = 0; index < servers.size(); ++index) { const auto& server = servers[index]; JsonObject item = values.add<JsonObject>(); item["id"] = std::to_string(index); item["name"] = server.name; item["url"] = server.url; item["username"] = server.username; item["hasPassword"] = !server.password.empty(); item["filenameFormat"] = opdsFilenameFormatToJson(server.filenameFormat); item["syncAllBooks"] = server.syncAllBooks; item["primary"] = index == 0; }
+  std::string body; serializeJson(doc, body); sendResponse(client, 200, "application/json", body);
+}
+
+bool parsePortalIndex(JsonVariantConst value, size_t upper, size_t& result) {
+  const std::string id = value.as<std::string>(); char* end = nullptr; const long parsed = std::strtol(id.c_str(), &end, 10);
+  if (id.empty() || end == nullptr || *end != '\0' || parsed < 0 || static_cast<size_t>(parsed) >= upper) return false;
+  result = static_cast<size_t>(parsed); return true;
+}
+
+void savePortalOpds(int client, const Request& request) {
+  JsonDocument doc; if (deserializeJson(doc, request.body)) { sendResponse(client,400,"application/json","{\"error\":\"Invalid JSON\"}"); return; }
+  OpdsServer server; server.name = doc["name"] | std::string(); server.url = doc["url"] | std::string(); server.username = doc["username"] | std::string(); server.filenameFormat = opdsFilenameFormatFromJson(doc["filenameFormat"] | ""); server.syncAllBooks = doc["syncAllBooks"] | false;
+  if (server.name.empty() || server.url.empty()) { sendResponse(client,400,"application/json","{\"error\":\"Name and URL are required\"}"); return; }
+  bool saved = false; size_t index = 0;
+  if (doc["id"].is<JsonVariant>() && parsePortalIndex(doc["id"], OPDS_STORE.getCount(), index)) { const auto* old = OPDS_STORE.getServer(index); server.password = doc["password"].is<const char*>() && std::strlen(doc["password"].as<const char*>()) ? doc["password"].as<const char*>() : old->password; saved = OPDS_STORE.updateServer(index, server); }
+  else { server.password = doc["password"] | std::string(); saved = OPDS_STORE.addServer(server); }
+  sendResponse(client, saved ? 200 : 500, "application/json", saved ? "{\"message\":\"OPDS catalog saved\"}" : "{\"error\":\"Could not save OPDS catalog\"}");
+}
+
