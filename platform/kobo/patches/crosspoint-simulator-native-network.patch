+void handlePostOpdsServer(int client, const Request &req) {
+  JsonDocument doc;
+  if (deserializeJson(doc, req.body)) {
+    sendResponse(client, 400, "text/plain", "Invalid JSON");
+    return;
+  }
+
+  OpdsServer server;
+  server.name = doc["name"] | std::string{};
+  server.url = doc["url"] | std::string{};
+  server.username = doc["username"] | std::string{};
+  server.password = doc["password"] | std::string{};
+  server.filenameFormat = opdsFilenameFormatFromJson(doc["filenameFormat"] | "");
+  if (server.url.empty() || server.url.size() > 127 || server.name.size() > 63 || server.username.size() > 63 ||
+      server.password.size() > 63) {
+    sendResponse(client, 400, "text/plain", "Invalid OPDS server fields");
+    return;
+  }
+
+  bool saved = false;
+  if (doc["index"].is<int>()) {
+    const int index = doc["index"].as<int>();
+    if (index < 0 || index >= static_cast<int>(OPDS_STORE.getCount())) {
+      sendResponse(client, 400, "text/plain", "Invalid server index");
+      return;
+    }
+    const OpdsServer *existing = OPDS_STORE.getServer(static_cast<size_t>(index));
+    if (existing != nullptr && !doc["password"].is<const char *>()) {
+      server.password = existing->password;
+    }
+    if (existing != nullptr && !doc["filenameFormat"].is<const char *>()) {
+      server.filenameFormat = existing->filenameFormat;
+    }
+    saved = OPDS_STORE.updateServer(static_cast<size_t>(index), server);
+  } else {
+    saved = OPDS_STORE.addServer(server);
+  }
+
+  if (!saved) {
+    sendResponse(client, 500, "text/plain", "Could not save OPDS server");
+    return;
+  }
+  // Never include the password in a response or log entry.
+  LOG_INF("WEB", "Native OPDS server configuration saved: %s", server.name.c_str());
+  sendResponse(client, 200, "text/plain", "OK");
+}
