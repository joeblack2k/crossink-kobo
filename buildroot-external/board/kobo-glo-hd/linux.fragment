# Existing N437 U-Boot passes ATAGs and loads a legacy uImage.
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=n
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=n
CONFIG_CMDLINE="console=ttymxc0,115200 root=/dev/mmcblk0p3 rootfstype=ext4 rootwait rw"
CONFIG_CMDLINE_FORCE=y

# The first bring-up image must have storage, USB ECM and SSH prerequisites
# built in; it cannot depend on modules before the root filesystem is mounted.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_ESDHC_IMX=y
CONFIG_USB=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_MXS_PHY=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_F_ECM=y
CONFIG_CONFIGFS_FS=y

# N437 daily-use hardware must be available before a module loader or network
# connection exists.  Keep the e-paper, touch, frontlight, battery and RTC
# path built in.  Wi-Fi remains modular and is installed in the rootfs.
CONFIG_MFD_RN5T618=y
CONFIG_REGULATOR_RN5T618=y
CONFIG_RN5T618_ADC=y
CONFIG_RN5T618_POWER=y
CONFIG_RTC_DRV_RC5T619=y
CONFIG_REGULATOR_TPS65185=y
CONFIG_DRM=y
CONFIG_DRM_MXC_EPDC=y
# Never bind the historical MXCFB stack alongside the DRM EPDC driver.
# CONFIG_FB_MXC is not set
# CONFIG_FB_MXC_EINK_PANEL is not set
# CONFIG_FB_MXC_EINK_V2_PANEL is not set
# EPDC is built in and probes before the rootfs firmware path is available.
# external.mk injects this device-owned file into the kernel source tree.
CONFIG_EXTRA_FIRMWARE="imx/epdc/epdc.fw"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"
CONFIG_MFD_NTXEC=y
CONFIG_PWM_NTXEC=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_TOUCHSCREEN_ZFORCE=y

# N437-only v1: remove drivers for later Kobo/Tolino boards and unrelated
# peripherals from the generic Kobo defconfig. Keep netfilter and USB storage
# for the planned hotspot/host-transfer modes.
# CONFIG_TOUCHSCREEN_EKTF2127 is not set
# CONFIG_TOUCHSCREEN_EDT_FT5X06 is not set
# CONFIG_MWIFIEX is not set
# CONFIG_MWIFIEX_SDIO is not set
# CONFIG_BT is not set
# CONFIG_WIREGUARD is not set
# CONFIG_BACKLIGHT_LM3630A is not set
# CONFIG_MFD_SY7636A is not set
# CONFIG_REGULATOR_SY7636A is not set
# CONFIG_SENSORS_SY7636A is not set
# CONFIG_REGULATOR_FP9931 is not set
# CONFIG_GPIO_BD71815 is not set
# CONFIG_GPIO_BD71828 is not set
# CONFIG_CHARGER_BD71828 is not set
# CONFIG_REGULATOR_BD71815 is not set
# CONFIG_COMMON_CLK_BD718XX is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_USB_TEST is not set
# CONFIG_USB_EHSET_TEST_FIXTURE is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set

# Keep diagnostics available from the first modern-kernel boot.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
